 -- ==========================================
-- SPECIAL FIX LAG SCRIPT: nhantamdz fixlag
-- Features: Removes extra effects, optimizes graphics, boosts FPS
-- ==========================================
print("=== nhantamdz fixlag has been successfully activated! ===")
local Lighting = game:GetService("Lighting")
local Terrain = game:GetService("Workspace"):FindFirstChildOfClass("Terrain")

-- 1. Optimize lighting and environment settings
if Terrain then
    Terrain.WaterWaveSize = 0
    Terrain.WaterWaveSpeed = 0
    Terrain.WaterReflectance = 0
    Terrain.WaterTransparency = 0
end
Lighting.GlobalShadows = false
Lighting.FogEnd = 9e9
Lighting.Brightness = 1

-- Disable heavy visual effects
for _, effect in pairs(Lighting:GetChildren()) do
    if effect:IsA("BlurEffect") or effect:IsA("SunRaysEffect") or effect:IsA("ColorCorrectionEffect") or effect:IsA("BloomEffect") then
        effect.Enabled = false
    end
end

-- 2. Optimize and smooth game objects (Workspace)
local function cleanObject(obj)
    -- Make textures/decals invisible to reduce memory usage
    if obj:IsA("Decal") or obj:IsA("Texture") then
        obj.Transparency = 1
    -- Turn off particle effects (smoke, fire, sparkles)
    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
        obj.Enabled = false
    -- Change block materials to Smooth Plastic
    elseif obj:IsA("MeshPart") or obj:IsA("Part") or obj:IsA("CornerWedgePart") or obj:IsA("WedgePart") then
        obj.Material = Enum.Material.SmoothPlastic
        obj.Reflectance = 0
    end
end

-- Clean all existing objects
for _, obj in pairs(workspace:GetDescendants()) do
    cleanObject(obj)
end

-- Automatically clean new objects
workspace.DescendantAdded:Connect(function(obj) cleanObject(obj) end)
print("=== Graphics optimized! Your game should run much smoother now. ===")

local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")

local targetFont = Enum.Font.Arcade

local function applyMinecraftFont(obj)
    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        pcall(function()
            if obj.Font ~= targetFont then
                obj.Font = targetFont
            end
        end)
    end
end

-- Quét và đổi các UI hiện tại
for _, gui in ipairs(playerGui:GetChildren()) do
    for _, descendant in ipairs(gui:GetDescendants()) do
        applyMinecraftFont(descendant)
    end
end

-- Lắng nghe khi có UI mới xuất hiện (Cực kỳ nhẹ, không gây lag)
playerGui.DescendantAdded:Connect(function(child)
task.spawn(function()
        applyMinecraftFont(child)
        for _, descendant in ipairs(child:GetDescendants()) do
            applyMinecraftFont(descendant)
        end
    end)
end)
