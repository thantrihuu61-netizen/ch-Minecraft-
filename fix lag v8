-- GRAYSCALE
local function GrayColor(color)
    local gray =
        color.R * 0.299 +
        color.G * 0.587 +
        color.B * 0.114

    return Color3.new(gray, gray, gray)
end

-- EFFECT CLEANER
local function Optimize(obj)
    pcall(function()

        -- PARTICLES AND SKILL EFFECTS
        if CONFIG.RemoveParticles then
            if obj:IsA("ParticleEmitter") then
                obj.Enabled = false
                obj:Clear()

            elseif obj:IsA("Trail")
            or obj:IsA("Beam")
            or obj:IsA("Fire")
            or obj:IsA("Smoke")
            or obj:IsA("Sparkles") then
                obj.Enabled = false
            end
        end

        -- LIGHTS
        if CONFIG.RemoveLights then
            if obj:IsA("PointLight")
            or obj:IsA("SpotLight")
            or obj:IsA("SurfaceLight") then
                obj.Enabled = false
            end
        end

        -- POST EFFECTS
        if CONFIG.RemovePostEffects then
            if obj:IsA("PostEffect") then
                obj.Enabled = false
            end
        end

        -- TEXTURES
        if CONFIG.RemoveTextures then
            if obj:IsA("Decal")
            or obj:IsA("Texture") then
                obj.Transparency = 1

            elseif obj:IsA("SurfaceAppearance") then
                obj:Destroy()

            elseif obj:IsA("MeshPart") then
                obj.TextureID = ""

            elseif obj:IsA("SpecialMesh") then
                obj.TextureId = ""
            end
        end

        -- HIGHLIGHTS
        if obj:IsA("Highlight") then
            obj.Enabled = false
        end

        -- ATMOSPHERE
        if obj:IsA("Atmosphere") then
            obj.Density = 0
            obj.Haze = 0
            obj.Glare = 0
        end

        -- CLOUDS
        if obj:IsA("Clouds") then
            obj.Enabled = false
        end

        -- PART OPTIMIZATION
        if obj:IsA("BasePart") then
            if CONFIG.RemoveShadows then
                obj.CastShadow = false
            end

            if CONFIG.LowMaterials then
                obj.Material = Enum.Material.Plastic
                obj.Reflectance = 0
            end

            if CONFIG.Grayscale then
                obj.Color = GrayColor(obj.Color)
            end
        end
    end)
end

-- INITIAL OPTIMIZATION
for _, obj in ipairs(Workspace:GetDescendants()) do
    Optimize(obj)
end

for _, obj in ipairs(Lighting:GetDescendants()) do
    Optimize(obj)
end

-- NEW OBJECT OPTIMIZATION
Workspace.DescendantAdded:Connect(Optimize)
Lighting.DescendantAdded:Connect(Optimize)

